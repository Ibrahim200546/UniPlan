name: Android APK Release
run-name: UniPlan build ${{ github.run_number }} · ${{ github.sha }}

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: uniplan-apk-${{ github.ref }}
  cancel-in-progress: true

defaults:
  run:
    shell: bash

env:
  EXPECTED_CERT_SHA256: 1b5edf62b174211a13ccc32883cd74006cca47cb0fb368ae839b9ed6e0651a42

jobs:
  build:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    permissions:
      contents: read
    env:
      SUPABASE_URL: ${{ vars.SUPABASE_URL }}
      SUPABASE_PUBLISHABLE_KEY: ${{ vars.SUPABASE_PUBLISHABLE_KEY }}
    steps:
      - name: Check out the exact commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false

      - name: Set up JDK 17
        uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad # v6.1.0
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Validate required public Supabase configuration
        run: |
          python3 - <<'PY'
          import os, re, sys
          from urllib.parse import urlparse
          url = os.environ.get('SUPABASE_URL', '')
          key = os.environ.get('SUPABASE_PUBLISHABLE_KEY', '')
          parsed = urlparse(url)
          if (url != url.strip() or parsed.scheme != 'https' or not parsed.hostname
                  or parsed.username or parsed.password or parsed.query or parsed.fragment
                  or parsed.path not in ('', '/')):
              sys.exit('::error::Set repository variable SUPABASE_URL to the HTTPS project URL.')
          if not re.fullmatch(r'sb_publishable_[A-Za-z0-9_-]+', key):
              sys.exit('::error::Set SUPABASE_PUBLISHABLE_KEY to a public sb_publishable_ key. Secret/service_role keys are forbidden.')
          PY

      - name: Restore the existing signing key and verify its certificate
        env:
          ANDROID_DEBUG_KEYSTORE_BASE64: ${{ secrets.ANDROID_DEBUG_KEYSTORE_BASE64 }}
        run: |
          set -euo pipefail
          if [[ -z "$ANDROID_DEBUG_KEYSTORE_BASE64" ]]; then
            echo '::error::Missing ANDROID_DEBUG_KEYSTORE_BASE64. Add the existing UniPlan signing key as a repository secret; a replacement key will not be generated.'
            exit 1
          fi
          umask 077
          mkdir -p "$HOME/.android"
          printf '%s' "$ANDROID_DEBUG_KEYSTORE_BASE64" | base64 --decode > "$HOME/.android/debug.keystore"
          actual=$(keytool -exportcert -keystore "$HOME/.android/debug.keystore" -alias androiddebugkey -storepass android | sha256sum | cut -d ' ' -f 1)
          if [[ "$actual" != "$EXPECTED_CERT_SHA256" ]]; then
            echo '::error::Signing certificate does not match the existing UniPlan downloads.'
            exit 1
          fi

      - name: Install the pinned Android SDK packages
        run: |
          set -euo pipefail
          sdkmanager="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          (yes || true) | "$sdkmanager" --licenses > /dev/null
          "$sdkmanager" 'platforms;android-35' 'build-tools;35.0.0'

      - name: Test and build the real authentication app
        run: |
          set -euo pipefail
          chmod +x gradlew
          ./gradlew --no-daemon --console=plain \
            -PciBuildNumber="$GITHUB_RUN_NUMBER" \
            -PsupabaseUrl="$SUPABASE_URL" \
            -PsupabasePublishableKey="$SUPABASE_PUBLISHABLE_KEY" \
            :app:testDebugUnitTest :app:assembleDebug

      - name: Verify the APK and prepare release files
        run: |
          set -euo pipefail
          apk='app/build/outputs/apk/debug/app-debug.apk'
          test -s "$apk"
          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --verbose --print-certs "$apk" > "$RUNNER_TEMP/apk-signature.txt"
          actual=$(awk -F': ' '/^Signer #1 certificate SHA-256 digest:/ {print tolower($2)}' "$RUNNER_TEMP/apk-signature.txt" | tr -d ':[:space:]')
          [[ "$actual" == "$EXPECTED_CERT_SHA256" ]] || { echo '::error::APK certificate mismatch'; exit 1; }
          python3 - <<'PY'
          import json, os
          with open('app/build/outputs/apk/debug/output-metadata.json', encoding='utf-8') as stream:
              metadata = json.load(stream)
          assert metadata['applicationId'] == 'kz.uniplan.app', 'Refusing to publish a demo or unexpected package'
          assert len(metadata['elements']) == 1, 'Expected one installable APK'
          assert metadata['elements'][0]['versionCode'] == 1000 + int(os.environ['GITHUB_RUN_NUMBER']), 'CI versionCode was not applied'
          PY
          mkdir -p dist
          cp "$apk" dist/UniPlan.apk
          (cd dist && sha256sum UniPlan.apk > SHA256SUMS)

      - name: Upload the verified files for the publisher
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: uniplan-${{ github.run_id }}
          path: dist/
          if-no-files-found: error
          retention-days: 14
          overwrite: true

      - name: Keep unit-test reports
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: tests-${{ github.run_id }}
          path: |
            app/build/test-results/testDebugUnitTest/
            app/build/reports/tests/testDebugUnitTest/
          if-no-files-found: ignore
          retention-days: 14
          overwrite: true

      - name: Remove the temporary signing key
        if: always()
        run: rm -f -- "$HOME/.android/debug.keystore"

  publish:
    needs: build
    if: github.ref == 'refs/heads/main' && needs.build.result == 'success'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: write
    env:
      GH_TOKEN: ${{ github.token }}
      GH_REPO: ${{ github.repository }}
      RELEASE_TAG: build-${{ github.run_number }}
    steps:
      - name: Download only this run's verified artifact
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: uniplan-${{ github.run_id }}
          path: dist

      - name: Stage assets, then publish the current main build
        run: |
          set -euo pipefail
          test -s dist/UniPlan.apk
          (cd dist && sha256sum --check SHA256SUMS)
          main_sha=$(gh api "repos/$GH_REPO/git/ref/heads/main" --jq .object.sha)
          if [[ "$main_sha" != "$GITHUB_SHA" ]]; then
            echo 'A newer main commit exists; this build will not replace Latest.' >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi

          if gh api "repos/$GH_REPO/releases/tags/$RELEASE_TAG" > release.json 2> release-error.txt; then
            if [[ $(jq -r .draft release.json) != true ]]; then
              echo "Release $RELEASE_TAG is already published; rerun leaves it unchanged." >> "$GITHUB_STEP_SUMMARY"
              exit 0
            fi
            [[ $(jq -r .target_commitish release.json) == "$GITHUB_SHA" ]] || { echo '::error::Existing draft targets another commit'; exit 1; }
          else
            grep -q 'HTTP 404' release-error.txt || { cat release-error.txt; exit 1; }
            # An existing tag must resolve to this commit, never silently reuse another build.
            if gh api "repos/$GH_REPO/git/ref/tags/$RELEASE_TAG" > tag.json 2> tag-error.txt; then
              [[ $(jq -r .object.type tag.json) == commit && $(jq -r .object.sha tag.json) == "$GITHUB_SHA" ]] || { echo '::error::Existing tag targets another object'; exit 1; }
            else
              grep -q 'HTTP 404' tag-error.txt || { cat tag-error.txt; exit 1; }
            fi
            printf 'UniPlan Android APK\n\nCommit: %s\nBuild: %s\n\nUnit tests and APK signature checks passed in this workflow. Device UI and live Supabase authentication are not verified by this build.\n' "$GITHUB_SHA" "$GITHUB_RUN_NUMBER" > release-notes.txt
            gh release create "$RELEASE_TAG" --target "$GITHUB_SHA" --draft --latest=false \
              --title "UniPlan build $GITHUB_RUN_NUMBER" --notes-file release-notes.txt
          fi

          # Only drafts are overwritten. Published releases are immutable to this workflow.
          [[ $(gh api "repos/$GH_REPO/releases/tags/$RELEASE_TAG" --jq .draft) == true ]] || { echo '::error::Release is no longer a draft'; exit 1; }
          gh release upload "$RELEASE_TAG" dist/UniPlan.apk dist/SHA256SUMS --clobber
          gh api "repos/$GH_REPO/releases/tags/$RELEASE_TAG" > ready.json
          jq -e '[.assets[] | select(.state == "uploaded") | .name] | (index("UniPlan.apk") != null and index("SHA256SUMS") != null)' ready.json > /dev/null
          main_sha=$(gh api "repos/$GH_REPO/git/ref/heads/main" --jq .object.sha)
          if [[ "$main_sha" != "$GITHUB_SHA" ]]; then
            echo 'Main changed during upload. Complete files remain in a draft; Latest was not changed.' >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          gh release edit "$RELEASE_TAG" --draft=false --latest
          printf '[Download UniPlan.apk](https://github.com/%s/releases/latest/download/UniPlan.apk)\n' "$GH_REPO" >> "$GITHUB_STEP_SUMMARY"
