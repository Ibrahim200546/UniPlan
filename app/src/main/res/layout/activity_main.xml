        app:itemTextAppearanceActive="@style/TextAppearance.UniPlan.Navigation" app:itemTextAppearanceInactive="@style/TextAppearance.UniPlan.Navigation"
        app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
