<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_subjects" android:textSize="26sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/add"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/noneButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/no_subject" style="@style/Widget.Material3.Button.OutlinedButton"/>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_subjects_empty" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp"/>
</LinearLayout>
