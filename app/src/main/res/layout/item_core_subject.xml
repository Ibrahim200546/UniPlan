<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:padding="12dp" android:background="?attr/selectableItemBackground">
    <ImageView android:id="@+id/icon" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:padding="8dp" android:src="@drawable/ic_book" android:contentDescription="@string/subject"/>
    <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/icon" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface"/>
    <TextView android:id="@+id/teacherText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/icon" android:layout_below="@id/titleText" android:layout_marginTop="4dp" android:textSize="14sp"/>
</RelativeLayout>
