<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_edit_task" android:textSize="24sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/title">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/titleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/description">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/descriptionInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/subjectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/select_subject" style="@style/Widget.Material3.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/manageSubjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/manage_subjects" style="@style/Widget.Material3.Button.OutlinedButton"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_kind" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <RadioGroup android:id="@+id/kindGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/assignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_assignment"/>
            <RadioButton android:id="@+id/exam" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_exam"/>
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_due" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/dueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_pick_date" style="@style/Widget.Material3.Button.OutlinedButton"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_priority" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <RadioGroup android:id="@+id/priorityGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/low" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_low"/>
            <RadioButton android:id="@+id/normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_normal"/>
            <RadioButton android:id="@+id/high" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_high"/>
        </RadioGroup>
        <CheckBox android:id="@+id/completed" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/core_mark_done"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
