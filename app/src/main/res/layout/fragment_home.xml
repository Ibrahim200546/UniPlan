<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="24dp" android:orientation="vertical">
  <TextView android:id="@+id/dateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:layout_marginTop="12dp" android:letterSpacing="0.03"/>
  <TextView android:id="@+id/welcomeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/groupText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginTop="6dp" android:visibility="gone"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_overview" android:textSize="13sp" android:letterSpacing="0.06" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
   <TextView android:id="@+id/activeText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="76dp" android:padding="12dp" android:background="?attr/colorPrimaryContainer" android:textSize="17sp" android:lineSpacingExtra="8dp" android:fontFamily="sans-serif-medium"/>
   <TextView android:id="@+id/doneText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="76dp" android:padding="12dp" android:layout_marginStart="8dp" android:textSize="17sp" android:lineSpacingExtra="8dp"/>
   <TextView android:id="@+id/overdueText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="76dp" android:padding="12dp" android:layout_marginStart="8dp" android:textSize="17sp" android:lineSpacingExtra="8dp"/>
  </LinearLayout>
  <androidx.fragment.app.FragmentContainerView android:id="@+id/quickActions" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <com.google.android.material.card.MaterialCardView android:id="@+id/setupPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardElevation="0dp" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_first_step" android:textSize="20sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_setup_help" android:textSize="15sp" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/addSubject" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_add_subject" app:icon="@drawable/ic_add" android:layout_marginTop="8dp"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_upcoming_tasks" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"/>
  <TextView android:id="@+id/emptyTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_no_upcoming_tasks" android:textSize="15sp" android:paddingVertical="16dp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/tasksList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_upcoming_lessons" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"/>
  <TextView android:id="@+id/emptyLessons" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_no_upcoming_lessons" android:textSize="15sp" android:paddingVertical="16dp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/lessonsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>