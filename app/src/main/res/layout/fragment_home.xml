<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:id="@+id/dateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_intro" android:textSize="14sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/welcomeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/today" android:textSize="28sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/groupText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:paddingBottom="16dp" android:textColor="?attr/colorOnSurface" android:visibility="gone"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_intro" android:textSize="20sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <TextView android:id="@+id/activeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_active" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <TextView android:id="@+id/doneText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_completed" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <TextView android:id="@+id/overdueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_overdue" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.fragment.app.FragmentContainerView android:id="@+id/quickActions" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_home_empty" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_upcoming_tasks" android:textSize="20sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/emptyTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_no_upcoming_tasks" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tasksList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_upcoming_lessons" android:textSize="20sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/emptyLessons" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/core_no_upcoming_lessons" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurface"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/lessonsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
