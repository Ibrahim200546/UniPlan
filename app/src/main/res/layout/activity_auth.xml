<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="28dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:gravity="center_horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/language" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end"
            android:text="@string/switch_russian" android:textSize="12sp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_auth_decoration" android:importantForAccessibility="no" />
            <ImageView android:layout_width="126dp" android:layout_height="126dp" android:layout_gravity="center"
                android:background="@drawable/bg_logo_halo" android:padding="18dp" android:src="@drawable/ic_logo" android:contentDescription="@string/brand_description" />
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:gravity="center" android:fontFamily="sans-serif-medium" android:textSize="28sp" android:letterSpacing="-0.03" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_title"
            android:gravity="center" android:textSize="13sp" android:tag="muted" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/authHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/design_sign_in_title" android:gravity="center" android:textAppearance="@style/TextAppearance.UniPlan.Heading"
            android:layout_marginTop="28dp" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auth_subtitle" android:gravity="center" android:textSize="14sp" android:tag="muted"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
        <LinearLayout android:id="@+id/demoPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_mode" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/demoOne" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/auth_demo_one" />
            <com.google.android.material.button.MaterialButton android:id="@+id/demoTwo" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/auth_demo_two" />
        </LinearLayout>
        <LinearLayout android:id="@+id/credentials" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:textSize="15sp" android:inputType="textCapSentences" android:autofillHints="name" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/email">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:textSize="15sp" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:textSize="15sp" android:inputType="textPassword" android:saveEnabled="false" android:autofillHints="password" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/repeatBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/auth_repeat" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/repeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:textSize="15sp" android:inputType="textPassword" android:saveEnabled="false" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/reset" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:text="@string/auth_reset" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginTop="12dp" android:text="@string/auth_sign_in" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/toggle" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/auth_create_account" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/cancelRecovery" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/google"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center"
            android:text="@string/auth_google"
            android:textAllCaps="false"
            android:textColor="@color/auth_google_ink"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="0"
            app:backgroundTint="@color/auth_google_surface"
            app:strokeColor="#D1D9E0"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp"
            app:rippleColor="#2425292E"
            app:icon="@drawable/ic_google_brand"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@null" />
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/appVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:gravity="center" android:textSize="11sp" android:tag="muted" android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
